# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Required — shared passwords for the two roles. Generate with:
#   openssl rand -base64 24
STUDENT_PASSWORD=replace-with-long-random-secret
FACULTY_PASSWORD=replace-with-different-long-random-secret

# Optional — comma-separated list of browser origins allowed to call /api/chat.
# Leave unset to keep the function permissive (rate limit still applies).
ALLOWED_ORIGIN=https://esaip-ai-assistant.vercel.app
